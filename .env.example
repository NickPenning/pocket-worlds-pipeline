# Kopieer dit bestand naar .env en vul in met je eigen sleutels.
# .env wordt NOOIT gecommit (staat in .gitignore) — alleen voor lokaal testen.
# In GitHub Actions komen dezelfde waarden via Settings > Secrets and variables > Actions.

ANTHROPIC_API_KEY=sk-ant-...
LEONARDO_API_KEY=...

# Numeriek Instagram User ID (NIET de Meta App ID) — ophalen met get_ig_user_id.py
IG_USER_ID=...
IG_ACCESS_TOKEN=...

# Basis-URL waar de media/ map van deze repo publiek bereikbaar is, bv.:
# https://raw.githubusercontent.com/<jouw-gebruikersnaam>/pocket-worlds-pipeline/main/media
MEDIA_PUBLIC_BASE_URL=https://raw.githubusercontent.com/<jouw-gebruikersnaam>/pocket-worlds-pipeline/main/media
